# Configuración General del Proyecto
PROJECT_NAME=Tadimex
VERSION=1.0.0
DESCRIPTION="Sistema integral de gestión empresarial Tadimex"
ENVIRONMENT=development  

# Configuración del Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=True
WORKERS=4

# Configuración de API y Seguridad
API_V1_STR=/api/v1

# Configuracion autenticacion
SECRET_KEY=secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
VERIFY_SSL=False

# Configuración de CORS para el frontend
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173","http://localhost:3000","http://localhost:8080", "http://tadimex-frontend"]

# Configuración de MariaDB
MARIADB_USER=admin # Cambiar a tadimex_user si se usa en Docker
MARIADB_PASSWORD=H8cf708NQ9o73jU2ggQ4 # Cambiar a tadimex_password si se usa en Docker
MARIADB_HOST=mariadb #Cambiar a MariaDB si se usa en Docker
MARIADB_PORT=3306
MARIADB_DATABASE=tadimex_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_URL=mysql+pymysql://${MARIADB_USER}:${MARIADB_PASSWORD}@${MARIADB_HOST}:${MARIADB_PORT}/${MARIADB_DATABASE}

# Configuración de Archivos y Almacenamiento
UPLOAD_FOLDER=static/uploads
LOGOS_FOLDER=static/logos
COTIZACIONES_FOLDER=static/cotizaciones
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=["pdf","png","jpg","jpeg","xlsx","docx"]
IMAGE_EXTENSIONS=["png","jpg","jpeg", "webp"]
CERTIFICATE_EXTENSION=["cer"]
PRIVATE_KEY_EXTENSION=["key"]